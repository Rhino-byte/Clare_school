# Database (Postgres recommended; SQLite works for local demo)
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/clare_school

# Firebase Admin (service account JSON path or inline project id)
FIREBASE_PROJECT_ID=your-project-id
GOOGLE_APPLICATION_CREDENTIALS=./firebase-service-account.json
# Or set FIREBASE_CREDENTIALS_JSON as a single-line JSON string

# Cloudflare R2
R2_ACCOUNT_ID=your-account-id
R2_ACCESS_KEY_ID=your-access-key
R2_SECRET_ACCESS_KEY=your-secret-key
R2_BUCKET_NAME=clare-media
R2_PUBLIC_URL=

# API
API_CORS_ORIGINS=http://localhost:3000
CONTACT_EMAIL=admissions@stclare.example
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

# Next.js (apps/web/.env.local)
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
